# Copy to .env and fill in. Never commit .env.

# ── Gemini ── get a key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# ── Database ── Supabase → Connect → Session pooler (contains your DB password)
# Leave empty to use the local Docker Postgres on port 5433.
DATABASE_URL=

# ── App ──
OTP_SECRET=change-me
PORT=3001
